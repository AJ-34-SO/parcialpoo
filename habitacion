public class habitacion {
    String tipo;
    int cantidad_noches;
    String n_habitacion;
    double tarifa;



    public habitacion(String tipo,String n_habitacion,double tarifa, int cantidad_noches){
        this.tipo=tipo;
        this.n_habitacion=n_habitacion;
        this.tarifa=tarifa;
        this.cantidad_noches=cantidad_noches;
    }

    public void devolver_noches(int cantidad_noches)throws cantidadenochesException {
        if (cantidad_noches<= 0) {
            throw new cantidadenochesException("la cantidad de noches no es valida");
        }
    }
}
